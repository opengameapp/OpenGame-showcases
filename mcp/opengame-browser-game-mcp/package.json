{
  "name": "opengame-browser-game-mcp",
  "mcpName": "io.github.opengameapp/browser-game",
  "version": "0.1.3",
  "description": "A local MCP server for planning and validating focused browser-game prototypes.",
  "type": "module",
  "bin": {
    "opengame-browser-game-mcp": "dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && tsx --test src/*.test.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-game",
    "game-design",
    "threejs",
    "canvas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opengameapp/OpenGame-showcases.git",
    "directory": "mcp/opengame-browser-game-mcp"
  },
  "bugs": {
    "url": "https://github.com/opengameapp/OpenGame-showcases/issues"
  },
  "homepage": "https://opengame.app/",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
